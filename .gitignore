# Build output
build/
app/build/
.gradle/
local.properties

# Fetched, not vendored (see fetchBungee in app/build.gradle.kts)
native-dsp/bungee/

# Cross-compiled by cargoBuild
app/src/main/jniLibs/
native/target/

# Native build scratch (CMake/Ninja, regenerated by every build)
app/.cxx/

# Local agent settings: machine-specific, and no business in a public repo
.claude/

# Signing. The keystore and its passwords never go near the repository.
*.jks
*.keystore
keystore.properties

# IDE
.idea/
*.iml
.DS_Store
