    <string name="onboarding_start">Bắt đầu nghe</string>
    <string name="onboarding_welcome_1">Nhạc Spotify của bạn, kèm lời bài hát, canvas và hiệu ứng âm thanh.</string>
    <string name="onboarding_welcome_2">Cần tài khoản Spotify Premium.</string>
    <string name="onboarding_welcome_3">Ba bước là sẵn sàng. Chỉ mất năm phút, một lần duy nhất.</string>
    <string name="onboarding_step_of">Bước %1$d / %2$d</string>
    <string name="onboarding_login_title">Đăng nhập Spotify</string>
    <string name="onboarding_login_1">Trình duyệt mở trang Spotify. Bạn cấp quyền, rồi nó đưa bạn quay lại đây.</string>
    <string name="onboarding_login_2">Bạn chỉ nhập mật khẩu trên trang chính thức của Spotify: Square không bao giờ nhìn thấy mật khẩu đó.</string>
    <string name="onboarding_login_done">Đã đăng nhập</string>
    <string name="onboarding_key_title">Tạo khóa của bạn</string>
    <string name="onboarding_key_intro">Tìm kiếm và đề xuất dùng API của Spotify, cần khóa cá nhân. Việc này mất khoảng một phút, miễn phí và không cần thẻ.</string>
    <string name="onboarding_open_dashboard">Mở dashboard</string>
    <string name="onboarding_step_login">Đăng nhập bằng cùng tài khoản Spotify.</string>
    <string name="onboarding_step_create">Ở góc trên bên phải, bấm «Create app».</string>
    <string name="onboarding_step_names">App name và App description: nhập gì bạn thích, ví dụ Square. Website: để trống.</string>
    <string name="onboarding_step_redirect">Redirect URI: dán dòng bên dưới rồi bấm «Add». Kiểm tra nó xuất hiện trong danh sách dưới ô nhập, nếu không là chưa được lưu.</string>
    <string name="onboarding_step_api">Trong «Which API/SDKs are you planning to use?» hãy chọn Web API.</string>
    <string name="onboarding_step_terms">Chấp nhận điều khoản rồi bấm «Save».</string>
    <string name="onboarding_step_client_id">Trên trang app, bấm «Settings»: Client ID nằm dưới «Basic Information». Sao chép nó.</string>
    <string name="onboarding_step_secret">Không cần Client secret: đừng sao chép và đừng nhập nó ở đâu.</string>
    <string name="onboarding_paste_title">Dán Client ID</string>
    <string name="onboarding_paste_done">Xong: tìm kiếm và đề xuất đã bật.</string>
    <string name="onboarding_key_linked">Đã kết nối khóa</string>
    <string name="onboarding_paste_hint">Dán Client ID vào đây rồi bấm Kết nối. Trình duyệt sẽ mở lần cuối để xác nhận.</string>
    <string name="onboarding_paste_error">Nếu trình duyệt báo lỗi, hãy quay lại bước trước: gần như luôn là Redirect URI chưa được thêm vào danh sách.</string>
    <string name="onboarding_done_title">Đã sẵn sàng</string>
    <string name="onboarding_done_1">Trang chủ có danh sách phát của bạn, và biểu tượng kính lúp tìm trong toàn bộ catalog.</string>
    <string name="onboarding_done_2">Trong trình phát, vuốt để đổi bài và mở lời, hàng đợi, hiệu ứng từ thanh dưới ảnh bìa.</string>
    <string name="onboarding_done_3">Bạn có thể xem lại hướng dẫn này trong Cài đặt, bằng cách chạm vào ảnh của bạn trên trang chủ.</string>

