    <!-- Web API setup -->
    <string name="turn_on_search">TURN ON SEARCH</string>
    <string name="web_api_explainer">Search goes through Spotify\'s web API, which has a request limit per application. Register an app in the developer dashboard and paste its client ID here: then the limit is yours alone.</string>
    <string name="redirect_uri_note">This exact Redirect URI has to be added to the app:</string>

    <!-- Onboarding -->
    <string name="onboarding_start">Start listening</string>
    <string name="onboarding_welcome_1">Your Spotify music, with lyrics, canvas and audio effects.</string>
    <string name="onboarding_welcome_2">A Spotify Premium account is required.</string>
    <string name="onboarding_welcome_3">Two steps and you are ready. Five minutes, once.</string>
    <string name="onboarding_login_title">1. Log in to Spotify</string>
    <string name="onboarding_login_1">The browser opens on Spotify\'s page. You authorise, and it brings you back here.</string>
    <string name="onboarding_login_2">You only ever type your password on Spotify\'s own page: Square never sees it.</string>
    <string name="onboarding_login_done">Logged in</string>
    <string name="onboarding_key_title">2. Create your key</string>
    <string name="onboarding_key_intro">Search and recommendations go through Spotify\'s API, which has to be used with a personal key. It takes a minute, it is free, and no card is needed.</string>
    <string name="onboarding_open_dashboard">Open the dashboard</string>
    <string name="onboarding_step_login">Log in with the same Spotify account.</string>
    <string name="onboarding_step_create">Top right, press «Create app».</string>
    <string name="onboarding_step_names">App name and App description: anything you like, for instance Square. Website: leave it empty.</string>
    <string name="onboarding_step_redirect">Redirect URI: paste the line below and press «Add». Check that it appears in the list under the field, or it is not saved.</string>
    <string name="onboarding_step_api">Under «Which API/SDKs are you planning to use?» tick Web API.</string>
    <string name="onboarding_step_terms">Accept the terms and press «Save».</string>
    <string name="onboarding_step_client_id">On the app\'s page press «Settings»: the Client ID is under «Basic Information». Copy it.</string>
    <string name="onboarding_step_secret">The Client secret is not needed: do not copy it and do not enter it anywhere.</string>
    <string name="onboarding_paste_title">3. Paste the Client ID</string>
    <string name="onboarding_paste_done">Done: search and recommendations are on.</string>
    <string name="onboarding_key_linked">Key connected</string>
    <string name="onboarding_paste_hint">Paste the Client ID here and press Connect. The browser opens one last time to confirm.</string>
    <string name="onboarding_paste_error">If the browser shows an error, go back one step: nearly always the Redirect URI was not added to the list.</string>
    <string name="onboarding_done_title">All set</string>
    <string name="onboarding_done_1">Home has your playlists, and the lens searches the whole catalogue.</string>
    <string name="onboarding_done_2">In the player, swipe to change song and open lyrics, queue and effects from the bar under the cover.</string>
    <string name="onboarding_done_3">You can see this guide again from Settings, by tapping your picture on the home page.</string>

