    <string name="onboarding_start">Commencer à écouter</string>
    <string name="onboarding_welcome_1">Votre musique Spotify, avec paroles, canvas et effets audio.</string>
    <string name="onboarding_welcome_2">Un compte Spotify Premium est nécessaire.</string>
    <string name="onboarding_welcome_3">Deux étapes et c\'est prêt. Cinq minutes, une seule fois.</string>
    <string name="onboarding_login_title">1. Connectez-vous à Spotify</string>
    <string name="onboarding_login_1">Le navigateur s\'ouvre sur la page de Spotify. Vous autorisez et vous revenez ici tout seul.</string>
    <string name="onboarding_login_2">Le mot de passe ne s\'écrit que sur la page de Spotify : Square ne le voit pas.</string>
    <string name="onboarding_login_done">Connexion effectuée</string>
    <string name="onboarding_key_title">2. Créez votre clé</string>
    <string name="onboarding_key_intro">La recherche et les recommandations passent par l\'API de Spotify, qui s\'utilise avec une clé personnelle. Cela prend une minute, c\'est gratuit et aucune carte n\'est demandée.</string>
    <string name="onboarding_open_dashboard">Ouvrir le tableau de bord</string>
    <string name="onboarding_step_login">Connectez-vous avec le même compte Spotify.</string>
    <string name="onboarding_step_create">En haut à droite, appuyez sur « Create app ».</string>
    <string name="onboarding_step_names">App name et App description : ce que vous voulez, par exemple Square. Website : laissez vide.</string>
    <string name="onboarding_step_redirect">Redirect URI : collez la ligne ci-dessous et appuyez sur « Add ». Vérifiez qu\'elle apparaît dans la liste sous le champ, sinon elle n\'est pas enregistrée.</string>
    <string name="onboarding_step_api">À « Which API/SDKs are you planning to use? », cochez Web API.</string>
    <string name="onboarding_step_terms">Acceptez les conditions et appuyez sur « Save ».</string>
    <string name="onboarding_step_client_id">Sur la page de l\'app, appuyez sur « Settings » : le Client ID est sous « Basic Information ». Copiez-le.</string>
    <string name="onboarding_step_secret">Le Client secret ne sert à rien : ne le copiez pas et ne le saisissez nulle part.</string>
    <string name="onboarding_paste_title">3. Collez le Client ID</string>
    <string name="onboarding_paste_done">C\'est fait : recherche et recommandations sont actives.</string>
    <string name="onboarding_key_linked">Clé connectée</string>
    <string name="onboarding_paste_hint">Collez ici le Client ID et appuyez sur Connecter. Le navigateur s\'ouvre une dernière fois pour confirmer.</string>
    <string name="onboarding_paste_error">Si le navigateur affiche une erreur, revenez à l\'étape précédente : presque toujours le Redirect URI n\'a pas été ajouté à la liste.</string>
    <string name="onboarding_done_title">Tout est prêt</string>
    <string name="onboarding_done_1">L\'accueil contient vos playlists, et la loupe cherche dans tout le catalogue.</string>
    <string name="onboarding_done_2">Dans le lecteur, balayez pour changer de titre et ouvrez paroles, file et effets depuis la barre sous la pochette.</string>
    <string name="onboarding_done_3">Vous pouvez revoir ce guide depuis les Réglages, en touchant votre photo sur l\'accueil.</string>

