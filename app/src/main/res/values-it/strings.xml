    <string name="turn_on_search">ATTIVA LA RICERCA</string>
    <string name="web_api_explainer">La ricerca usa le API web di Spotify, che hanno un limite di richieste per applicazione. Registra un\'app nel dashboard per sviluppatori e incolla qui il suo client id: così il limite è solo tuo.</string>
    <string name="redirect_uri_note">Nell\'app va aggiunto questo Redirect URI, identico:</string>

    <string name="onboarding_start">Inizia ad ascoltare</string>
    <string name="onboarding_welcome_1">La tua musica Spotify, con testi, canvas ed effetti audio.</string>
    <string name="onboarding_welcome_2">Serve un account Spotify Premium.</string>
    <string name="onboarding_welcome_3">Due passaggi e sei pronto. Ci vogliono cinque minuti, una volta sola.</string>
    <string name="onboarding_login_title">1. Accedi a Spotify</string>
    <string name="onboarding_login_1">Si apre il browser sulla pagina di Spotify. Autorizzi e torni qui da solo.</string>
    <string name="onboarding_login_2">La password la scrivi solo nella pagina di Spotify: Square non la vede.</string>
    <string name="onboarding_login_done">Accesso completato</string>
    <string name="onboarding_key_title">2. Crea la tua chiave</string>
    <string name="onboarding_key_intro">La ricerca e i consigli passano dalle API di Spotify, che vanno usate con una chiave personale. Si crea in un minuto, è gratis e non serve nessuna carta.</string>
    <string name="onboarding_open_dashboard">Apri il dashboard</string>
    <string name="onboarding_step_login">Accedi con lo stesso account Spotify.</string>
    <string name="onboarding_step_create">In alto a destra premi «Create app».</string>
    <string name="onboarding_step_names">App name e App description: scrivi quello che vuoi, per esempio Square. Website: lascia vuoto.</string>
    <string name="onboarding_step_redirect">Redirect URI: incolla la riga qui sotto e premi «Add». Controlla che compaia nell\'elenco sotto al campo, altrimenti non viene salvata.</string>
    <string name="onboarding_step_api">Alla voce «Which API/SDKs are you planning to use?» spunta Web API.</string>
    <string name="onboarding_step_terms">Accetta i termini e premi «Save».</string>
    <string name="onboarding_step_client_id">Nella pagina dell\'app premi «Settings»: sotto «Basic Information» trovi il Client ID. Copialo.</string>
    <string name="onboarding_step_secret">Il Client secret non serve: non copiarlo e non inserirlo da nessuna parte.</string>
    <string name="onboarding_paste_title">3. Incolla il Client ID</string>
    <string name="onboarding_paste_done">Fatto: ricerca e consigli sono attivi.</string>
    <string name="onboarding_key_linked">Chiave collegata</string>
    <string name="onboarding_paste_hint">Incolla qui il Client ID e premi Collega. Il browser si apre un\'ultima volta per confermare.</string>
    <string name="onboarding_paste_error">Se il browser dà errore, torna al passo prima: quasi sempre il Redirect URI non è stato aggiunto all\'elenco.</string>
    <string name="onboarding_done_title">Tutto pronto</string>
    <string name="onboarding_done_1">In home ci sono le tue playlist, con la lente cerchi in tutto il catalogo.</string>
    <string name="onboarding_done_2">Nel player scorri per cambiare brano e apri testi, coda ed effetti dalla barra sotto la copertina.</string>
    <string name="onboarding_done_3">Puoi rivedere questa guida da Impostazioni, toccando la tua foto in home.</string>

