    <string name="turn_on_search">ACTIVA LA BÚSQUEDA</string>
    <string name="web_api_explainer">La búsqueda usa la API web de Spotify, que tiene un límite de peticiones por aplicación. Registra una app en el panel para desarrolladores y pega aquí su client ID: así el límite es solo tuyo.</string>
    <string name="redirect_uri_note">En la app hay que añadir este Redirect URI, idéntico:</string>

    <string name="onboarding_start">Empieza a escuchar</string>
    <string name="onboarding_welcome_1">Tu música de Spotify, con letras, canvas y efectos de audio.</string>
    <string name="onboarding_welcome_2">Hace falta una cuenta Spotify Premium.</string>
    <string name="onboarding_welcome_3">Dos pasos y listo. Cinco minutos, una sola vez.</string>
    <string name="onboarding_login_title">1. Entra en Spotify</string>
    <string name="onboarding_login_1">Se abre el navegador en la página de Spotify. Autorizas y vuelves aquí solo.</string>
    <string name="onboarding_login_2">La contraseña solo la escribes en la página de Spotify: Square no la ve.</string>
    <string name="onboarding_login_done">Sesión iniciada</string>
    <string name="onboarding_key_title">2. Crea tu clave</string>
    <string name="onboarding_key_intro">La búsqueda y las recomendaciones pasan por la API de Spotify, que debe usarse con una clave personal. Se crea en un minuto, es gratis y no hace falta ninguna tarjeta.</string>
    <string name="onboarding_open_dashboard">Abrir el panel</string>
    <string name="onboarding_step_login">Entra con la misma cuenta de Spotify.</string>
    <string name="onboarding_step_create">Arriba a la derecha pulsa «Create app».</string>
    <string name="onboarding_step_names">App name y App description: lo que quieras, por ejemplo Square. Website: déjalo vacío.</string>
    <string name="onboarding_step_redirect">Redirect URI: pega la línea de abajo y pulsa «Add». Comprueba que aparece en la lista bajo el campo, o no se guarda.</string>
    <string name="onboarding_step_api">En «Which API/SDKs are you planning to use?» marca Web API.</string>
    <string name="onboarding_step_terms">Acepta los términos y pulsa «Save».</string>
    <string name="onboarding_step_client_id">En la página de la app pulsa «Settings»: bajo «Basic Information» está el Client ID. Cópialo.</string>
    <string name="onboarding_step_secret">El Client secret no hace falta: no lo copies ni lo introduzcas en ningún sitio.</string>
    <string name="onboarding_paste_title">3. Pega el Client ID</string>
    <string name="onboarding_paste_done">Listo: búsqueda y recomendaciones activas.</string>
    <string name="onboarding_key_linked">Clave conectada</string>
    <string name="onboarding_paste_hint">Pega aquí el Client ID y pulsa Conectar. El navegador se abre una última vez para confirmar.</string>
    <string name="onboarding_paste_error">Si el navegador da error, vuelve al paso anterior: casi siempre el Redirect URI no se añadió a la lista.</string>
    <string name="onboarding_done_title">Todo listo</string>
    <string name="onboarding_done_1">En inicio están tus playlists, y con la lupa buscas en todo el catálogo.</string>
    <string name="onboarding_done_2">En el reproductor desliza para cambiar de canción y abre letra, cola y efectos desde la barra bajo la portada.</string>
    <string name="onboarding_done_3">Puedes ver esta guía otra vez en Ajustes, tocando tu foto en inicio.</string>

