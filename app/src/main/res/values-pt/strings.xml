    <string name="turn_on_search">ATIVE A BUSCA</string>
    <string name="web_api_explainer">A busca usa a API web do Spotify, que tem um limite de requisições por aplicação. Registre um app no painel de desenvolvedores e cole aqui o client ID dele: assim o limite é só seu.</string>
    <string name="redirect_uri_note">No app é preciso acrescentar este Redirect URI, idêntico:</string>

    <string name="onboarding_start">Comece a ouvir</string>
    <string name="onboarding_welcome_1">Sua música do Spotify, com letras, canvas e efeitos de áudio.</string>
    <string name="onboarding_welcome_2">É preciso uma conta Spotify Premium.</string>
    <string name="onboarding_welcome_3">Dois passos e está pronto. Cinco minutos, uma vez só.</string>
    <string name="onboarding_login_title">1. Entre no Spotify</string>
    <string name="onboarding_login_1">O navegador abre na página do Spotify. Você autoriza e volta para cá sozinho.</string>
    <string name="onboarding_login_2">A senha você digita só na página do Spotify: o Square não a vê.</string>
    <string name="onboarding_login_done">Acesso concluído</string>
    <string name="onboarding_key_title">2. Crie a sua chave</string>
    <string name="onboarding_key_intro">A busca e as recomendações passam pela API do Spotify, que precisa de uma chave pessoal. Leva um minuto, é grátis e não pede cartão.</string>
    <string name="onboarding_open_dashboard">Abrir o painel</string>
    <string name="onboarding_step_login">Entre com a mesma conta do Spotify.</string>
    <string name="onboarding_step_create">No alto à direita toque em «Create app».</string>
    <string name="onboarding_step_names">App name e App description: o que você quiser, por exemplo Square. Website: deixe vazio.</string>
    <string name="onboarding_step_redirect">Redirect URI: cole a linha abaixo e toque em «Add». Confira que ela aparece na lista sob o campo, senão não é salva.</string>
    <string name="onboarding_step_api">Em «Which API/SDKs are you planning to use?» marque Web API.</string>
    <string name="onboarding_step_terms">Aceite os termos e toque em «Save».</string>
    <string name="onboarding_step_client_id">Na página do app toque em «Settings»: sob «Basic Information» está o Client ID. Copie-o.</string>
    <string name="onboarding_step_secret">O Client secret não é preciso: não copie e não digite em lugar nenhum.</string>
    <string name="onboarding_paste_title">3. Cole o Client ID</string>
    <string name="onboarding_paste_done">Pronto: busca e recomendações estão ativas.</string>
    <string name="onboarding_key_linked">Chave conectada</string>
    <string name="onboarding_paste_hint">Cole aqui o Client ID e toque em Conectar. O navegador abre uma última vez para confirmar.</string>
    <string name="onboarding_paste_error">Se o navegador der erro, volte um passo: quase sempre o Redirect URI não foi acrescentado à lista.</string>
    <string name="onboarding_done_title">Tudo pronto</string>
    <string name="onboarding_done_1">No início ficam suas playlists, e com a lupa você busca em todo o catálogo.</string>
    <string name="onboarding_done_2">No player deslize para trocar de faixa e abra letra, fila e efeitos na barra sob a capa.</string>
    <string name="onboarding_done_3">Dá para rever este guia nas Configurações, tocando na sua foto no início.</string>

