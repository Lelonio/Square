<?xml version="1.0" encoding="utf-8"?>
<!-- The playlists last opened, in whatever room is left at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_playlists"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="12dp"
    android:layout_weight="1"
    android:gravity="bottom"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_playlist_0"
        style="@style/WidgetPlaylist" />

    <ImageView
        android:id="@+id/widget_playlist_1"
        style="@style/WidgetPlaylist" />

    <ImageView
        android:id="@+id/widget_playlist_2"
        style="@style/WidgetPlaylist" />

    <ImageView
        android:id="@+id/widget_playlist_3"
        style="@style/WidgetPlaylist" />
</LinearLayout>
