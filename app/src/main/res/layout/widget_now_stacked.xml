<?xml version="1.0" encoding="utf-8"?>
<!--
  The song above its controls, for a widget too narrow to have both on one
  line: there the title was squeezed down to an ellipsis.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_previous"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/previous"
            android:padding="12dp"
            android:src="@drawable/ic_widget_previous" />

        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_button_primary"
            android:padding="14dp"
            android:src="@drawable/ic_pip_play"
            android:tint="#FF111114" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/next"
            android:padding="12dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</LinearLayout>
