<?xml version="1.0" encoding="utf-8"?>
<!--
    The Canvas video surface.

    Inflated from XML rather than constructed in code for one reason:
    `surface_type` is a PlayerView construction-time attribute with no setter,
    and the default — a SurfaceView — is punched through the window rather than
    drawn into the view hierarchy. Nothing that samples a graphics layer can see
    it, so the glass panes over the player were refracting an empty layer and
    came out as flat translucent panels with the video simply visible underneath.

    A TextureView draws into the hierarchy like any other view, which is what
    makes it recordable, and costs an extra copy per frame for one short clip.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:shutter_background_color="@android:color/transparent" />
