<?xml version="1.0" encoding="utf-8"?>
<!-- Dev builds can be profiled from the shell (simpleperf, Perfetto's
     callstack sampling) without being debuggable, which would change what
     is measured. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <profileable android:shell="true" />
        <!-- Soloist on Android, a probe; see dev/SoloistProbe. Only the shell
             (which holds DUMP) can send it. -->
        <receiver
            android:name=".dev.SoloistProbe"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
